@model InvoiceViewModel
@{
    ViewData["Title"] = $"Invoice #{Model.OrderID}";
}
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Back to my orders</a>
    <button class="btn btn-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print invoice</button>
</div>
<div class="invoice-paper card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between flex-wrap gap-3 border-bottom pb-4 mb-4">
            <div>
                <p class="eyebrow mb-1">B2B WHOLESALE</p>
                <h1 class="h2 fw-bold mb-1">Order invoice</h1>
                <p class="text-secondary mb-0">Wholesale order summary</p>
            </div>
            <div class="text-lg-end">
                <div class="h4 fw-bold">#@Model.OrderID</div>
                <div class="text-secondary">@Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                <span class="badge text-bg-primary mt-2">@Model.OrderStatus</span>
            </div>
        </div>
        <div class="row g-4 mb-4">
            <div class="col-md-7">
                <h2 class="h6 text-uppercase text-secondary">Bill to</h2>
                <div class="fw-semibold">@Model.AgentName</div>
                <div>@Model.AgentAddress</div>
                <div>@Model.AgentPhone</div>
            </div>
            <div class="col-md-5 text-md-end">
                <h2 class="h6 text-uppercase text-secondary">Document</h2>
                <div>Invoice / Order #@Model.OrderID</div>
                <div>Currency: VND</div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Item</th><th>Pack size</th><th class="text-end">Qty</th><th class="text-end">Unit amount</th><th class="text-end">Line total</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="fw-semibold">@line.ItemName</td>
                        <td>@line.Size</td>
                        <td class="text-end">@line.Quantity</td>
                        <td class="text-end">@line.UnitAmount.ToString("N0")</td>
                        <td class="text-end">@line.LineTotal.ToString("N0")</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="4" class="text-end">Total</th><th class="text-end fs-5">@Model.Total.ToString("N0") VND</th></tr></tfoot>
            </table>
        </div>
        <p class="text-secondary small mt-4 mb-0">This invoice is generated from the order stored in the B2B Wholesale Management System.</p>
    </div>
</div>
