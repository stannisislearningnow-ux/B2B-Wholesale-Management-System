@model IReadOnlyList<Item>
@{
    ViewData["Title"] = "Item catalog";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="eyebrow mb-1">AGENT WORKSPACE</p>
        <h1 class="h2 fw-bold mb-1">Wholesale catalog</h1>
        <p class="text-secondary mb-0">Current products, pack sizes, prices and available inventory.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Orders" asp-action="Place"><i class="bi bi-cart-plus me-2"></i>Create an order</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Item</th><th>Pack size</th><th class="text-end">Unit price</th><th class="text-end">Available stock</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.ItemName</td>
                    <td class="text-secondary">@item.Size</td>
                    <td class="text-end">@item.Price.ToString("N0") VND</td>
                    <td class="text-end"><span class="badge @(item.StockQuantity <= 10 ? "text-bg-warning" : "text-bg-success")">@item.StockQuantity</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
